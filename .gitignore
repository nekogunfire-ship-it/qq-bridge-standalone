# Dependencies
node_modules/
.npm-cache/

# Runtime state and local config (never publish)
state/
config.json
*.log
*.bak
*.bak-*

# 配置备份 —— 任何工具写出来的都一律不入库：它们含着你的 QQ 号与令牌。
# （config-portability 的 import 会写 archive/config.json.before-import-<时间戳>，
#   安装向导会写 archive/config.json.before-setup-<时间戳>，
#   卸载会写 cordis.patch.yml.before-qq-bridge-uninstall —— 都不是源码。）
/archive/config.json*
*.before-import-*
*.before-setup-*
*.before-qq-bridge-uninstall

# 配置导出包（tools/config-portability.mjs 生成）：完整包含 QQ 号与令牌，
# 脱敏包虽可分享但属于"产物"而非源码 —— 一律不入库，需要时现导。
config-bundle-*.json

# 打包产物（tools/package-dist.mjs 生成）：staging 目录与 zip
dist/

# 启动器运行时目录：init.json（含本机路径）、launched-pids.json（PID）、
# launcher-*.json（每次调用的结果）、*.log —— 全部由 tools/qq-bridge-launcher.ps1
# 自动生成（见其中 `if (-not (Test-Path $Runtime)) { New-Item ... }`），不是源码。
tools/runtime/

# Local development / planning / research docs (not part of public project)
/PROJECT_GUIDE.md
/ARCH_REVIEW.md
/DSH_QQ_TOOLS_PLAN.md
/GEN2_SIMULATION_PLAN.md
/SOCIAL_MODE_PLAN.md
/RESEARCH_QQ_MESSAGE_DND.md
/RESEARCH_SNOWLUMA_EMOJI_STICKER.md
/SnowLuma功能调研.md
/真人语感策略.md
# 花费实测档案：含个人用量数据，且未被任何公开文档引用 —— 默认不发布。
# （如需公开，删掉这一行并挪到 docs/ 后从 README 链接，避免成为孤儿文件。）
/TOKEN_COST.md

# 本地模型选型 / 硬件配置调研（内部笔记，无任何公开文档引用）
/LOCAL_MODEL_SIZING.md

# 大体积演示视频（10.93 MB）：改由 Release 附件托管，README 有链接。
# 注意：移除只影响此后提交、--depth 1 克隆与 Release 的 Source zip；
# 历史中的旧 blob 仍在，完整 clone 的体积要等历史重写后才会下降。
/assets/project-intro.mp4

# Local one-off dev/debug/patch scripts
# (machine-specific paths/IDs, or bound to artifacts of a single probe run under state/)
/scripts/cleanup-probe-sessions.mjs
/scripts/cleanup-probe-workspaces.mjs
/scripts/cleanup-test-sessions.mjs
/scripts/debug-whitelist.mjs
/scripts/diag-archive.mjs
/scripts/fix-probe-workspace-title.mjs
/scripts/patch-qq-chat-v2-collect-memory.mjs
/scripts/patch-qq-chat-v2-presleep.mjs
/scripts/patch-qq-chat-v2-stickers.mjs
/scripts/patch-web-mcp-timeout.mjs
